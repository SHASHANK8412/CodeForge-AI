# Copy to .env and fill in what you need. Never commit .env.

# --- Core -------------------------------------------------------------------
# SQLite by default. PostgreSQL also works but requires `pip install psycopg2-binary`.
DATABASE_URL=sqlite:///./backend/database/memory.db
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated browser origins allowed to call the API (e.g. your Vercel URL).
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Local LLM (Ollama) -------------------------------------------------------
# Read by the ollama client. In Docker the compose file defaults this to the host's Ollama.
OLLAMA_HOST=http://127.0.0.1:11434
# Optional model overrides (otherwise chosen from the models installed in Ollama).
# On CPU-only machines a small model such as llama3.2:3b is much faster.
AIFORGE_GENERAL_MODEL=
AIFORGE_CODING_MODEL=
AIFORGE_DEBUG_MODEL=
# Upper bound for a single LLM call; CPU-only inference can need several minutes.
AIFORGE_LLM_TIMEOUT_SECONDS=900

# --- Self-healing / validation ----------------------------------------------
MAX_REPAIR_ATTEMPTS=3
# LLM-based root-cause analysis in the background SRE monitor (off: it competes with generation).
AIFORGE_SRE_LLM_RCA=false

# --- GitHub export ------------------------------------------------------------
GITHUB_TOKEN=

# --- Cloud deployment ---------------------------------------------------------
# Automated API deployment is not implemented yet; without these the deploy step
# reports NOT_CONFIGURED, with them MANUAL_DEPLOY_REQUIRED plus instructions.
VERCEL_TOKEN=
RENDER_API_KEY=
NEON_API_KEY=

# --- Frontend (build time) ------------------------------------------------------
# URL the browser uses to reach the backend; set this when the frontend is hosted elsewhere.
VITE_API_URL=http://localhost:8000

# --- Security -------------------------------------------------------------
# Reject API requests without a valid login token (default: off, single-user local mode).
# Turn this on whenever AIForge is reachable from other machines.
AIFORGE_REQUIRE_AUTH=0
# Allow agent tools that run Python, shell commands, Docker or database operations.
AIFORGE_ENABLE_CODE_TOOLS=0
