# Locally generated JWT signing key (backend/auth/security.py)
backend/data/jwt_secret.key

# AIForge Autopilot analyses, findings, plans and executions (runtime data)
backend/data/evolution/

# AIForge Digital Twin graphs and impact reports (runtime data)
backend/data/twin/

# AIForge Performance Engineer runs, findings and comparisons (runtime data)
backend/data/performance/

# Benchmark Lab run artifacts (generated code and outputs)
benchmarks/runs/
backend/data/benchmark_lab/

# AIForge Chaos Engineer assessments, findings and repair gates (runtime data)
backend/data/chaos/
