# Verified fixes remembered per user (contain diffs of users' code)
backend/data/fix_memory.json

# Local verifiable-records signing key (generated on first use; never committed)
backend/data/verifiable_ledger/signing.key

# Benchmark output (written by benchmarks/run_benchmarks.py; not committed)
benchmarks/REPORT.md
benchmarks/results.json
benchmarks/runs/

# Benchmark run outputs (generated projects are large; results.json and REPORT.md are kept)
benchmarks/runs/*/projects/

# Runtime data the app writes while running (user accounts, generations, chats, memories, agent runs, reports,
# databases). Never committed: it holds users' data. Seed documents in backend/data/docs/ stay tracked.
backend/data/**/*.json
backend/data/**/*.pkl
backend/database/*.db
backend/database/*.json
backend/logs/*.json
backend/reports/*.json
backend/reports/*.md
logs/*.json
